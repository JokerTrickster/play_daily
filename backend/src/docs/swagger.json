                        "description": "메모 제목",
                        "name": "title",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "메모 내용 (Deprecated)",
                        "name": "content",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "생성 방식 (map 또는 list)",
                        "name": "creation_mode",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
